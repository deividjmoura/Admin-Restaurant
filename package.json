{
  "name": "admin-restaurant",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma SaaS Multi-Tenant para Lanchonetes",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "test": "node --test test/**/*.test.js",
    "lint": "echo \"lint placeholder\"",
    "test:unit": "node --test test/isolation/menu-cache.test.js test/isolation/tenant-resolution.test.js test/isolation/order-scoping.test.js test/isolation/cart-version.test.js test/isolation/pix-static.test.js",
    "test:isolation": "node --test test/isolation/**/*.test.js",
    "web": "npm run dev --prefix frontend",
    "web:build": "npm run build --prefix frontend"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.2.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2"
  }
}
