# =============================================================================
# Admin-Restaurant — Environment Variables
# Copie este arquivo para .env e preencha os valores.
# Nunca commite o arquivo .env real.
# =============================================================================

# --- Database ---
DATABASE_URL=postgres://usuario:senha@localhost:5432/admin_restaurant
# Em serviços gerenciados (Neon, Render, etc.) normalmente:
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
DATABASE_SSL=false
# PG_POOL_MAX=10
# PG_CONNECT_TIMEOUT_MS=10000

# --- Server ---
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Auth ---
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=7d
COOKIE_SECRET=troque-por-outro-segredo-diferente

# --- Seed inicial ---
# OBRIGATÓRIA quando NODE_ENV=production: mínimo 12 caracteres e diferente dos
# valores de exemplo. O seed cria SUPER_ADMIN/OWNER com acesso total e aborta
# sem ela. Nunca use o valor de exemplo em produção.
STAFF_SEED_PASSWORD=
SUPER_ADMIN_EMAIL=admin@plataforma.local

# --- Tenant / Domínio ---
# Em produção: seudominio.com (subdomínios = lojas)
# Em desenvolvimento local use hosts ou um domínio de teste
BASE_DOMAIN=localhost

# --- Tables / QR ---
# Sessão de mesa expira após N horas (QR físico continua válido)
TABLE_SESSION_TTL_HOURS=6

# --- Menu cache ---
# MENU_CACHE_TTL_MS=60000

# --- PIX (estático inicial — depois virá provider) ---
# Configure também por loja: stores.settings.pix = { key, name, city }
# PIX_CHAVE=seu@email.com
# PIX_NOME=LANCHONETE
# PIX_CIDADE=SAO PAULO

# --- Timezone do estabelecimento (relatórios) ---
APP_TIMEZONE=America/Sao_Paulo

# --- Rate limit (opcional) ---
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=100

# --- Frontend CORS (produção) ---
# OBRIGATÓRIA em produção (fail-closed): lista de origens separada por vírgula.
# Sem ela a aplicação NÃO sobe, porque refletir qualquer Origin com
# credentials:true permitiria que qualquer site usasse a sessão do usuário.
# CORS_ORIGIN=https://seu-front.vercel.app,https://admin.sualanchonete.com
# FRONTEND_ORIGIN=https://seu-front.vercel.app

# --- Sessão / cookies ---
# Arquitetura recomendada: SPA e API na MESMA origem (proxy /api → backend).
# Nesse caso mantenha lax (default). Só use 'none' se o frontend estiver
# obrigatoriamente em outro domínio — e nesse caso o cookie vira Secure e o
# risco de CSRF/cross-site precisa ser aceito explicitamente.
# COOKIE_SAMESITE=lax

# --- Proxy reverso ---
# Habilite quando houver proxy confiável na frente da API (rate limit por IP
# real). 1 = primeiro proxy; use o número correto de hops.
# TRUST_PROXY=1

# --- Rate limit de login ---
# LOGIN_RATE_LIMIT_MAX=5
# LOGIN_RATE_LIMIT_WINDOW=1 minute
# LOGIN_IDENTITY_MAX=10

# --- Webhooks de pagamento ---
# Um segredo por provider. Sem segredo configurado o webhook responde 404
# (provider desabilitado) — nunca aceite webhook não assinado.
# WEBHOOK_SECRET_MERCADOPAGO=cole-o-segredo-do-provider
# WEBHOOK_SECRET_STRIPE=whsec_...

# --- PIX ---
# Em produção a chave da plataforma NÃO é usada como fallback: loja sem
# settings.pix.key responde PIX_NOT_CONFIGURED.
# PIX_ALLOW_PLATFORM_KEY=false
