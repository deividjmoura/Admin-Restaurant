# =============================================================================
# Admin-Restaurant — Environment Variables
# Copie este arquivo para .env e preencha os valores.
# Nunca commite o arquivo .env real.
# =============================================================================

# --- Database ---
DATABASE_URL=postgres://usuario:senha@localhost:5432/admin_restaurant
# Em serviços gerenciados (Neon, Render, etc.) normalmente:
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
DATABASE_SSL=false
# PG_POOL_MAX=10
# PG_CONNECT_TIMEOUT_MS=10000

# --- Server ---
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Auth ---
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=7d
COOKIE_SECRET=troque-por-outro-segredo-diferente

# --- Seed inicial ---
STAFF_SEED_PASSWORD=troque-esta-senha
SUPER_ADMIN_EMAIL=admin@plataforma.local

# --- Tenant / Domínio ---
# Em produção: seudominio.com (subdomínios = lojas)
# Em desenvolvimento local use hosts ou um domínio de teste
BASE_DOMAIN=localhost

# --- Tables / QR ---
# Sessão de mesa expira após N horas (QR físico continua válido)
TABLE_SESSION_TTL_HOURS=6

# --- Menu cache ---
# MENU_CACHE_TTL_MS=60000

# --- PIX (estático inicial — depois virá provider) ---
# PIX_CHAVE=
# PIX_NOME=LANCHONETE
# PIX_CIDADE=SAO PAULO

# --- Timezone do estabelecimento (relatórios) ---
APP_TIMEZONE=America/Sao_Paulo

# --- Rate limit (opcional) ---
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=100
